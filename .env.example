NODE_ENV=production
SOMA_DOMAIN=school.example.com
APP_URL=https://school.example.com
API_URL=https://school.example.com/api
ALLOWED_ORIGINS=https://school.example.com
PORT=3000
WEB_PORT=8080
API_PORT=3000
WORKER_HEALTH_PORT=3001
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-server-side-only
EMAIL_PROVIDER=unconfigured
EMAIL_FROM_ADDRESS=no-reply@example.com
# Optional dedicated contact address for Let's Encrypt renewal notices.
TLS_CONTACT_EMAIL=
SMS_PROVIDER=unconfigured
PAYMENT_PROVIDER=mtn-momo-sandbox
MTN_MOMO_CONFIGURATION={}
STORAGE_CONFIGURATION={"provider":"supabase"}
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
# Host-only operational controls. Never add secret values to Git.
HEALTHCHECK_URL=https://school.example.com/health/ready
ALERT_WEBHOOK_URL=
# A trusted command that verifies the latest encrypted Supabase database and
# Storage backups. It must exit 0 only when recovery evidence is current.
BACKUP_CHECK_COMMAND=
