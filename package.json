{
  "name": "ourschool",
  "version": "0.1.0",
  "private": true,
  "description": "SOMA REPORT ENGINE Multi-School Academic Results and Report Card System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "start": "npm run start --workspace apps/api",
    "jobs": "npm run jobs --workspace apps/api",
    "health": "npm run health --workspace apps/api",
    "preflight:production": "sh scripts/production-preflight.sh",
    "sync:migrations": "node scripts/sync-academic-migrations.mjs",
    "migrate": "npm run sync:migrations && supabase db push"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
